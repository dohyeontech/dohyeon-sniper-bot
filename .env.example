# 이 봇은 시세 조회만 하며 실주문/API 키를 쓰지 않습니다.
# 상태 영속화(선택): 비공개 GitHub Gist 동기화를 쓸 때만 값을 채우세요.
# 실제 값은 절대 커밋하지 말고 Render Environment 또는 로컬 .env 에만 두세요.

# 필수 아님 — 상태 영속화용 GitHub 토큰 (gist 권한만 부여한 전용 토큰 권장)
GIST_TOKEN=

# 필수 아님 — 상태를 저장할 비공개 Gist ID
GIST_ID=

# 선택 — Render 가 주입하거나 로컬에서 바꿀 서버 포트 (기본 10000)
PORT=10000
